{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Integration Developer Adapters Process Definitions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{idcs-url}/oauth2/v1/authorize",
      "accessTokenUrl": "https://{idcs-url}/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Process Definitions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Integration List Process Definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/process-definitions"
          },
          "docs": "Retrieve a list of all process definitions."
        },
        {
          "info": {
            "name": "Oracle Integration Get Process Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/process-definitions/:processDefId/process-metadata",
            "params": [
              {
                "name": "processDefId",
                "value": "",
                "type": "path",
                "description": "Process definition identifier."
              }
            ]
          },
          "docs": "Retrieve metadata for a specific process definition."
        }
      ]
    }
  ],
  "bundled": true
}