{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Integration Developer Adapters Process Instances API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{idcs-url}/oauth2/v1/authorize",
      "accessTokenUrl": "https://{idcs-url}/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Process Instances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Integration List Process Instances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip."
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Filter query string."
              }
            ]
          },
          "docs": "Retrieve a list of process instances."
        },
        {
          "info": {
            "name": "Oracle Integration Create Process Instance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new process instance."
        },
        {
          "info": {
            "name": "Oracle Integration Get Process Instance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/:processId",
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "Process instance identifier."
              }
            ]
          },
          "docs": "Retrieve a specific process instance."
        },
        {
          "info": {
            "name": "Oracle Integration Update Process State",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/:processId",
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "Process instance identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the state of a process instance."
        },
        {
          "info": {
            "name": "Oracle Integration List Process Comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/:processId/comments",
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "Process instance identifier."
              }
            ]
          },
          "docs": "Retrieve comments for a process instance."
        },
        {
          "info": {
            "name": "Oracle Integration Add Process Comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/:processId/comments",
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "Process instance identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a comment to a process instance."
        },
        {
          "info": {
            "name": "Oracle Integration List Process Attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/:processId/attachments",
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "Process instance identifier."
              }
            ]
          },
          "docs": "Retrieve attachments for a process instance."
        },
        {
          "info": {
            "name": "Oracle Integration Get Instance Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/processes/instance-metrics"
          },
          "docs": "Retrieve process instance metrics."
        }
      ]
    }
  ],
  "bundled": true
}