{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Integration Developer Adapters Identities API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{idcs-url}/oauth2/v1/authorize",
      "accessTokenUrl": "https://{idcs-url}/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Identities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Integration List Identities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/identities"
          },
          "docs": "Retrieve a list of users, groups, and roles."
        },
        {
          "info": {
            "name": "Oracle Integration Get Logged in User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.integration.ocp.oraclecloud.com/ic/api/process/v1/identities/loggedInUser"
          },
          "docs": "Retrieve the currently logged in user."
        }
      ]
    }
  ],
  "bundled": true
}